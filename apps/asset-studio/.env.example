# Copy this file to .env.dev. The studio reads it at startup.

# Infer makes the shape plans and the textures.
INFER_API_URL=https://inferapi.aissabenfodda.ca/api
INFER_API_KEY=

# Infer reads images only from Bucket, so the studio uploads each reference image there.
BUCKET_BASE_URL=https://gammaapi.oasispath.ca
BUCKET_API_KEY=
BUCKET_UPLOAD_FOLDER_ID=
